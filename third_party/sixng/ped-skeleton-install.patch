+static FEMALE: OnceLock<Option<PedSkeleton>> = OnceLock::new();
+static MALE: OnceLock<Option<PedSkeleton>> = OnceLock::new();
+
+/// Install the shared ped skeleton from the `ambient_femalebody` / `ambient_malebody` fragment that the caller already
+/// holds, for a host that has no work directory with an index of packs.rpf. Call it before the first `get`. Returns
+/// false when the fragment has no usable skeleton or a skeleton was already loaded.
+pub fn install(female: bool, r: &Resource) -> bool {
+    let Some(skeleton) = skeleton_of(source_name(female), r) else { return false };
+    (if female { &FEMALE } else { &MALE }).set(Some(skeleton)).is_ok()
+}
