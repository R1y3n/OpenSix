+/// Declared fragment child drawables with at least one supported model.
+/// Child table layout from rpf9-explorer's RageModelDecoder at af54933.
+pub fn fragment_members(r: &Resource, info: &DrawableInfo) -> Vec<(usize, usize)> {
+    if info.tag.as_deref() != Some("ft") || r.sys.len() < 0x32 {
+        return vec![];
+    }
+    let Some(primary) = r.sys_off(r.u64(0x18)) else { return vec![] };
+    let count = r.u16(0x30) as usize;
+    if !(2..=4096).contains(&count) || primary + (count - 1) * 0x110 + 0xb0 > r.sys.len() {
+        return vec![];
+    }
+    let known: std::collections::HashSet<_> = info.models.iter()
+        .filter_map(|model| model.struct_off.checked_sub(8).map(|offset| offset as usize)).collect();
+    (0..count).filter_map(|i| {
+        let root = primary + i * 0x110;
+        (0..4).filter_map(|lod| lod_models(r, root, lod)).flatten()
+            .any(|offset| known.contains(&offset)).then_some((i, root))
+    }).collect()
+}
+
+pub fn select_fragment(r: &Resource, info: &mut DrawableInfo, root: usize) -> anyhow::Result<()> {
+    let mut originals = std::collections::HashMap::new();
+    for model in std::mem::take(&mut info.models) {
+        if let Some(offset) = model.struct_off.checked_sub(8) {
+            originals.entry(offset as usize).or_insert(model);
+        }
+    }
+    for lod in 0..4 {
+        for offset in lod_models(r, root, lod).into_iter().flatten() {
+            if let Some(model) = originals.get(&offset) {
+                let mut model = model.clone();
+                model.lod = lod;
+                model.part = false;
+                info.models.push(model);
+            }
+        }
+    }
+    anyhow::ensure!(!info.models.is_empty(), "Fragment drawable has no supported models");
+    info.bounds = bounds_at(r, root);
+    info.bounds_raw = (0..8).map(|i| r.f32(root + 0x2c + i * 4)).collect();
+    scope_drawable(r, info, root);
+    Ok(())
+}
